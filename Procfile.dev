backend: bash -c '. ./.dev-ports.conf.sh && exec .venv/bin/uvicorn app.main:app --host "${HOST:-127.0.0.1}" --port "$BACKEND_PORT" --reload'
dashboard: bash -c '. ./.dev-ports.conf.sh && cd dashboard && VITE_DEV_API_TARGET="http://127.0.0.1:$BACKEND_PORT" exec npm run dev -- --port "$DASHBOARD_PORT" --strictPort'
