      "title": "EndpointSpec",
      "type": "object"
    },
    "ErrorDetail": {
      "description": "Ein Fehler als **Kennung**, nicht als Satz.\n\nDer Text gehört ins UI und muss in DE und EN vorliegen; ein deutscher\nBackendtext in der englischen Oberfläche wäre auch bei sauberem Parsen\nfalsch. `params` trägt die Werte, die der übersetzte Satz einsetzt — etwa\nden erkannten Ticker.\n\nBewusst **nicht** unter `detail` verschachtelt: FastAPIs Vorgabeform\n`{\"detail\": …}` zwänge jeden Konsumenten, erst auszupacken, was er dann\ndoch typisiert erwartet.",
      "properties": {
        "code": {
          "description": "Stabile Kennung, z.B. unknown_exchange_suffix",
          "title": "Code",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Werte für den übersetzten Text",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "FieldSpec": {
      "description": "Ein Feld des Core-Vertrags samt Art, Pflicht und Bedeutung.",
      "properties": {
        "kind": {
          "description": "string | number | integer | boolean | array | object",
          "title": "Kind",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
