  "schemas": {
    "AmbiguousSymbolDetail": {
      "description": "Der `409`, wenn mehrere Listings dasselbe Symbol tragen.\n\n**Die Form kommt aus T-24**, nicht aus diesem Ticket:\n`contract/fixtures/quote-409-ambiguous-symbol.json` zeigt `detail` und\n`candidates`, und die Fixture ist von außen benutzbar — StockPortfolio\nliest sie, ohne StockInfo zu starten.\n\n`code` und `params` kommen additiv dazu, damit dieser `409` dieselbe\nmaschinenlesbare Kennung trägt wie jede andere Ablehnung: Ein deutscher\nBackendtext in der englischen Oberfläche wäre auch bei sauberem Parsen\nfalsch, und `detail` ist genau so einer. Nach der Konsumentenregel des\nVertrags ignoriert ein bestehender Leser die zwei neuen Felder; ein neuer\nliest `code` und lässt `detail` liegen.",
      "properties": {
        "candidates": {
          "description": "Alle Listings, die dieses Symbol tragen",
          "items": {
            "$ref": "#/components/schemas/ListingCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "code": {
          "description": "Stabile Kennung: symbol_ambiguous",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "description": "Meldung aus dem T-24-Vertrag",
          "title": "Detail",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Werte für den übersetzten Text",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "detail",
        "code",
        "candidates"
      ],
      "title": "AmbiguousSymbolDetail",
      "type": "object"
    },
    "DailyPoint": {
      "description": "Ein Tages-Schlusskurs (EOD) der Langfrist-Historie.",
