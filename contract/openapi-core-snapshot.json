    },
    "FieldsResponse": {
      "description": "Antwort von ``GET /fields`` — der Vertrag zur Laufzeit.\n\nNach Antworttyp gegliedert, nicht flach: Ein Array mit `price` und\n`currency` sagt nicht, in welcher Antwort sie Pflicht sind, und wäre damit\nungenauer als das OpenAPI-Dokument.\n\nZwei Nummern, zwei Ebenen: `core_version` folgt SemVer über den\ngeschlossenen Core, `details_version` zählt die offene Detailmenge\n(siehe T-26). Ein Konsument mit gecachter Feldliste erkennt an ihnen, dass\ner neu holen muss, ohne den Inhalt zu vergleichen.",
      "properties": {
        "core": {
          "additionalProperties": {
            "items": {
              "$ref": "#/components/schemas/FieldSpec"
            },
            "type": "array"
          },
          "title": "Core",
          "type": "object"
        },
        "core_version": {
          "description": "SemVer des geschlossenen Core",
          "title": "Core Version",
          "type": "string"
        },
        "details": {
          "items": {
            "$ref": "#/components/schemas/FieldSpec"
          },
          "title": "Details",
          "type": "array"
        },
        "details_version": {
          "description": "Zähler der offenen Detailmenge",
          "title": "Details Version",
          "type": "integer"
        },
        "endpoints": {
          "additionalProperties": {
            "items": {
              "$ref": "#/components/schemas/EndpointSpec"
            },
            "type": "array"
          },
          "title": "Endpoints",
          "type": "object"
        }
      },
      "required": [
        "core_version",
        "core",
        "endpoints",
        "details_version"
      ],
      "title": "FieldsResponse",
      "type": "object"
    },
