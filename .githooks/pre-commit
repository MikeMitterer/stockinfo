#!/usr/bin/env bash
#------------------------------------------------------------------------------
# pre-commit — Nutzerdoku vor jedem Commit prüfen
#
# Aktiv über `git config core.hooksPath .githooks` (macht `make setup`).
# Richtet eine fehlende oder veraltete Einrichtung zuerst mit `make setup` ein
# (require-setup, require-tools). Prüft dann wie `make docs-check` und bricht
# den Commit ab, wenn die Prüfung Probleme meldet; Hinweise lassen ihn durch.
# Ohne Probleme erscheint nur die Ergebniszeile, sonst die vollständige
# Ausgabe. Scheitert die Einrichtung, bricht der Commit ab: Die Doku wird nie
# still übersprungen.
#
# Geprüft wird der vorgemerkte Stand, also genau das, was der Commit enthält:
# Der Hook schreibt den Index in ein temporäres Verzeichnis und lässt die
# Prüfung dort laufen, mit Git-Verzeichnis und Index dieses Repositorys.
# Nicht vorgemerkte Änderungen und neue, nicht vorgemerkte Dateien zählen
# deshalb nicht mit.
#
# Im Notfall umgehen: git commit --no-verify
#------------------------------------------------------------------------------

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
cd "${ROOT}"

# Bei `git commit -a` oder `git commit <pfad>` setzt git einen eigenen Index;
# ein relativer Pfad muss nach dem Wechsel ins Snapshot-Verzeichnis gelten.
if [[ -n "${GIT_INDEX_FILE:-}" && "${GIT_INDEX_FILE}" != /* ]]; then
    export GIT_INDEX_FILE="${ROOT}/${GIT_INDEX_FILE}"
fi

# Werkzeuge (make, devtools, pipx, pip) laufen ohne die Git-Variablen des Hooks: git setzt
# für ihn GIT_INDEX_FILE, und ein git-Aufruf, mit dem devtools ein Werkzeug holt, schriebe
# sonst in den Index dieses Repositorys.
without_git() {
    env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_OBJECT_DIRECTORY \
        -u GIT_COMMON_DIR "$@"
}

# Einrichtung und Werkzeuge im Checkout, nicht in der Kopie unten: Dort wäre jede Datei neuer
# als die Stempel, und .tools/ ist nur verlinkt. Fehlt etwas, läuft make setup; scheitert das,
# bricht der Commit mit dessen Meldung ab.
if ! without_git make --no-print-directory -s -C "${ROOT}" require-setup require-tools; then
    echo "Commit abgebrochen: Einrichtung fehlt, Doku nicht geprüft (siehe oben)." >&2
    echo "Im Notfall: git commit --no-verify" >&2
    exit 1
fi

SNAPSHOT="$(mktemp -d "${TMPDIR:-/tmp}/docs-check-index.XXXXXX")"
readonly SNAPSHOT
OUTPUT="$(mktemp "${TMPDIR:-/tmp}/docs-check.XXXXXX")"
readonly OUTPUT
trap 'command rm -rf -- "${SNAPSHOT}" "${OUTPUT}"' EXIT

git checkout-index --all --prefix="${SNAPSHOT}/"

# Die Werkzeuge aus make setup liegen unversioniert in .tools/ des Checkouts; docs-check findet
# sie im Snapshot nur über diesen Link.
ln -s "${ROOT}/.tools" "${SNAPSHOT}/.tools"

GIT_DIR="$(git rev-parse --absolute-git-dir)"
export GIT_DIR
export GIT_WORK_TREE="${SNAPSHOT}"

if make --no-print-directory -C "${SNAPSHOT}" docs-check-only >"${OUTPUT}" 2>&1; then
    # Ergebniszeile und Warnungen; vor dem ⚠ kann ein Farbcode stehen.
    grep -E '^Ergebnis|⚠' "${OUTPUT}" || true
    exit 0
fi

cat "${OUTPUT}"
echo
echo "Commit abgebrochen: make docs-check meldet Probleme im vorgemerkten Stand (siehe oben)."
echo "Beheben, vormerken und erneut committen; im Notfall: git commit --no-verify"
exit 1
